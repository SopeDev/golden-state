datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String?
  type     UserType
  provider String?

  accountStatus AccountStatus @default(PENDING_EMAIL)
  emailVerifiedAt DateTime?
  emailVerificationToken String? @unique
  emailVerificationExpires DateTime?

  adminApprovedAt DateTime?
  adminApprovedById Int?
  adminApprovedBy User? @relation("AdminApprovals", fields: [adminApprovedById], references: [id])
  approvedUsers User[] @relation("AdminApprovals")

  profile Json?

  accreditedStatus AccreditedStatus @default(NOT_STARTED)
  accreditedSubmittedAt DateTime?
  accreditedReviewedAt DateTime?
  accreditedReviewNote String?
  accreditationResubmitKinds Json?

  passwordResetToken String? @unique
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fundingContributions FundingContribution[] @relation("InvestorContributions")
  createdContributions FundingContribution[] @relation("ContributionCreatedBy")
  depositRequests DepositRequest[] @relation("InvestorDeposits")
  reviewedDepositRequests DepositRequest[] @relation("DepositReviewedBy")
  createdDepositRequests DepositRequest[] @relation("DepositCreatedBy")
  investorDocuments InvestorDocument[]
  investmentIntents InvestmentIntent[]
  returnDistributions ReturnDistribution[] @relation("InvestorReturnDistributions")
  createdReturnDistributions ReturnDistribution[] @relation("ReturnDistributionCreatedBy")
  cashOutRequests CashOutRequest[] @relation("InvestorCashOuts")
  reviewedCashOutRequests CashOutRequest[] @relation("CashOutReviewedBy")
  reinvestRequests ReinvestRequest[] @relation("InvestorReinvests")
  reviewedReinvestRequests ReinvestRequest[] @relation("ReinvestReviewedBy")
}

enum UserType {
  ADMIN
  INVESTOR
}

enum AccountStatus {
  PENDING_EMAIL
  PENDING_ADMIN
  ACTIVE
  REJECTED
}

enum AccreditedStatus {
  NOT_STARTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InvestorDocumentKind {
  ACCREDITATION
  INCOME_PROOF
  NET_WORTH
  GOVERNMENT_ID
  OTHER
}

model InvestorDocument {
  id        String               @id @default(cuid())
  userId    Int
  kind      InvestorDocumentKind
  fileUrl   String
  fileName  String
  mimeType  String
  uploadedAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InvestmentIntentStatus {
  STARTED
  ACCREDITATION_PENDING
  READY
  MEETING_REQUESTED
  AWAITING_WIRE
  COMPLETED
  CANCELLED
}

enum MeetingChannel {
  CALENDLY
  WHATSAPP
  VIDEO_CALL
  PHONE_CALL
  IN_PERSON
}

model InvestmentIntent {
  id               String                 @id @default(cuid())
  userId           Int
  propertyId       String
  status           InvestmentIntentStatus @default(STARTED)
  channel          MeetingChannel?
  intendedAmount   Float?
  meetingNote      String?
  meetingRequestedAt DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  depositRequests DepositRequest[]

  @@unique([userId, propertyId])
  @@index([status, updatedAt])
}

model PropertyType {
  id             String    @id @default(cuid())
  code           String    @unique
  slug           String    @unique
  labelEn        String
  labelEs        String
  descriptionEn  String    @default("")
  descriptionEs  String    @default("")
  sortOrder      Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  properties Property[]

  @@map("property_types")
}

model Property {
  id               String @id @default(cuid())
  investmentId     Int    @unique
  name             String
  slug             String @unique
  typeId           String
  city             String
  state            String
  address          String
  price            Int
  unitCount        Int
  minInvestment    Int
  estimatedROI     Float
  estimatedMonths  String
  /// Legacy column; public/admin surfaces compute investor ROI from ledger returns.
  actualRoi        Float?

  summary                    String   @default("")
  summaryEn                  String   @default("")
  summaryEs                  String   @default("")
  propertyFacts              Json
  propertyFactsSummary       Json     @default("{}")
  investmentDetails          Json
  investmentDetailsSummary   Json     @default("{}")
  images                     String[]

  status               PropertyStatus          @default(FUNDING)
  executionStatus      PropertyExecutionStatus @default(NONE)
  progressPercent      Int                     @default(0)
  startDate            DateTime?
  targetCompletionDate DateTime?
  completedAt          DateTime?
  deletedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyType           PropertyType          @relation(fields: [typeId], references: [id])
  fundingContributions   FundingContribution[]
  depositRequests        DepositRequest[]
  investmentIntents      InvestmentIntent[]
  documents              PropertyDocument[]
  returnDistributions    ReturnDistribution[]
  reinvestRequests       ReinvestRequest[]     @relation("ReinvestDestination")

  @@index([deletedAt])
  @@index([typeId])
}

enum PropertyStatus {
  FUNDING
  FUNDED
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum PropertyExecutionStatus {
  NONE
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum PropertyDocumentKind {
  CONSTRUCTION_PHOTOS
  CONTRACT
  FINANCIAL_REPORT
  PERMIT
  PROGRESS_UPDATE
  OTHER
}

model PropertyDocument {
  id           String               @id @default(cuid())
  propertyId   String
  kind         PropertyDocumentKind
  storageKey   String
  fileName     String
  mimeType     String
  uploadedAt   DateTime             @default(now())
  uploadedById Int?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, kind, uploadedAt])
}

enum FundingContributionSource {
  INVESTOR
  MANUAL
}

enum FundingContributionStatus {
  ACTIVE
  CANCELLED
}

enum DepositRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// Capital raise ledger. Investor holdings are ACTIVE + INVESTOR rows with userId.
model FundingContribution {
  id                   String                     @id @default(cuid())
  propertyId           String
  userId               Int?
  amount               Float
  source               FundingContributionSource
  status               FundingContributionStatus  @default(ACTIVE)
  label                String?
  note                 String?
  createdByAdminId     Int?
  depositRequestId     String?                    @unique
  reinvestmentRequestId String?                   @unique
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  cancelledAt          DateTime?

  property            Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user                User?            @relation("InvestorContributions", fields: [userId], references: [id], onDelete: Restrict)
  createdByAdmin      User?            @relation("ContributionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  depositRequest      DepositRequest?  @relation(fields: [depositRequestId], references: [id], onDelete: SetNull)
  reinvestmentRequest ReinvestRequest? @relation(fields: [reinvestmentRequestId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([userId, status])
  @@map("funding_contributions")
}

enum ReturnDistributionStatus {
  ACTIVE
  VOIDED
}

enum WalletRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// Property-attributed return credit into the investor wallet.
model ReturnDistribution {
  id               String                    @id @default(cuid())
  userId           Int
  propertyId       String
  amount           Float
  concept          String?
  note             String?
  distributedAt    DateTime                  @default(now())
  status           ReturnDistributionStatus  @default(ACTIVE)
  createdByAdminId Int?
  voidedAt         DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  user           User     @relation("InvestorReturnDistributions", fields: [userId], references: [id], onDelete: Restrict)
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdByAdmin User?    @relation("ReturnDistributionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([propertyId, createdAt])
  @@map("return_distributions")
}

model CashOutRequest {
  id           String              @id @default(cuid())
  userId       Int
  amount       Float
  status       WalletRequestStatus @default(PENDING)
  adminNote    String?
  reviewedAt   DateTime?
  reviewedById Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user       User  @relation("InvestorCashOuts", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("CashOutReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("cash_out_requests")
}

model ReinvestRequest {
  id                    String              @id @default(cuid())
  userId                Int
  amount                Float
  destinationPropertyId String
  status                WalletRequestStatus @default(PENDING)
  adminNote             String?
  reviewedAt            DateTime?
  reviewedById          Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                User                 @relation("InvestorReinvests", fields: [userId], references: [id], onDelete: Restrict)
  destinationProperty Property             @relation("ReinvestDestination", fields: [destinationPropertyId], references: [id], onDelete: Restrict)
  reviewedBy          User?                @relation("ReinvestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  contribution        FundingContribution?

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([destinationPropertyId, status])
  @@map("reinvest_requests")
}

model DepositRequest {
  id                 String               @id @default(cuid())
  userId             Int
  propertyId         String
  investmentIntentId String?
  amount             Float
  reference          String?
  depositedAt        DateTime?
  status             DepositRequestStatus @default(PENDING)
  adminNote          String?
  receiptStorageKey  String?
  receiptFileName    String?
  receiptMimeType    String?
  reviewedAt         DateTime?
  reviewedById       Int?
  createdByAdminId   Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user             User                  @relation("InvestorDeposits", fields: [userId], references: [id], onDelete: Restrict)
  property         Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  investmentIntent InvestmentIntent?     @relation(fields: [investmentIntentId], references: [id], onDelete: SetNull)
  reviewedBy       User?                 @relation("DepositReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdByAdmin   User?                 @relation("DepositCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  contribution     FundingContribution?

  @@index([status, createdAt])
  @@index([propertyId, status])
  @@index([userId, status])
  @@map("deposit_requests")
}

model PageContent {
  id        String   @id @default(cuid())
  pageKey   PageKey
  locale    String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageKey, locale])
}

enum PageKey {
  HOME
  ABOUT
  FAQ
  CONTACT
}
