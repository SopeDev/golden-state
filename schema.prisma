datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int   @id @default(autoincrement())
  email    String   @unique
  password String?  // Optional for OAuth users
  type     UserType
  provider String?  // Track auth provider: 'credentials', 'github', etc.
  createdAt DateTime @default(now())
  
  // Relations
  investments Investment[]
}

enum UserType {
  ADMIN
  INVESTOR
}

model Property {
  id               String   @id @default(cuid())
  investmentId     Int      @unique   // incremental ID shown to users
  name             String
  slug             String   @unique   // for clean URLs
  type             PropertyType
  city             String
  state            String
  address          String
  price            Int      // e.g. 3700000
  unitCount        Int
  minInvestment    Int
  estimatedROI     Float    // e.g. 4.5 (%)
  estimatedMonths  String   // e.g. "24" or "24-36"

  summary          String   // Executive summary (markdown or plain text)
  propertyFacts    Json     // JSON blob for technical facts
  investmentDetails Json    // JSON blob for funding breakdown
  images           String[] // Array of image URLs (used for carousel)

  status           PropertyStatus @default(IN_PROGRESS)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relations
  investments Investment[]
}

enum PropertyType {
  BUILD_TO_SELL
  BUILD_TO_RENT
  FLIPHOUSE
  MEX_TO_US
  US_TO_MEX
}

enum PropertyStatus {
  IN_PROGRESS
  COMPLETED
}

model Investment {
  id            String   @id @default(cuid())
  userId        Int
  propertyId    String
  amount        Float
  createdAt     DateTime @default(now())

  // Relations
  user          User     @relation(fields: [userId], references: [id])
  property      Property @relation(fields: [propertyId], references: [id])
}

model PageContent {
  id        String   @id @default(cuid())
  pageKey   PageKey
  locale    String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageKey, locale])
}

enum PageKey {
  HOME
  ABOUT
  FAQ
}

