datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String?
  type     UserType
  provider String?

  accountStatus AccountStatus @default(PENDING_EMAIL)
  emailVerifiedAt DateTime?
  emailVerificationToken String? @unique
  emailVerificationExpires DateTime?

  adminApprovedAt DateTime?
  adminApprovedById Int?
  adminApprovedBy User? @relation("AdminApprovals", fields: [adminApprovedById], references: [id])
  approvedUsers User[] @relation("AdminApprovals")

  profile Json?

  accreditedStatus AccreditedStatus @default(NOT_STARTED)
  accreditedSubmittedAt DateTime?
  accreditedReviewedAt DateTime?
  accreditedReviewNote String?
  accreditationResubmitKinds Json?

  passwordResetToken String? @unique
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investments Investment[]
  investorDocuments InvestorDocument[]
  investmentIntents InvestmentIntent[]
}

enum UserType {
  ADMIN
  INVESTOR
}

enum AccountStatus {
  PENDING_EMAIL
  PENDING_ADMIN
  ACTIVE
  REJECTED
}

enum AccreditedStatus {
  NOT_STARTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InvestorDocumentKind {
  ACCREDITATION
  INCOME_PROOF
  NET_WORTH
  GOVERNMENT_ID
  OTHER
}

model InvestorDocument {
  id        String               @id @default(cuid())
  userId    Int
  kind      InvestorDocumentKind
  fileUrl   String
  fileName  String
  mimeType  String
  uploadedAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InvestmentIntentStatus {
  STARTED
  ACCREDITATION_PENDING
  READY
  CANCELLED
}

model InvestmentIntent {
  id         String                 @id @default(cuid())
  userId     Int
  propertyId String
  status     InvestmentIntentStatus @default(STARTED)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model PropertyType {
  id             String    @id @default(cuid())
  code           String    @unique
  slug           String    @unique
  labelEn        String
  labelEs        String
  descriptionEn  String    @default("")
  descriptionEs  String    @default("")
  sortOrder      Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  properties Property[]

  @@map("property_types")
}

model Property {
  id               String @id @default(cuid())
  investmentId     Int    @unique
  name             String
  slug             String @unique
  typeId           String
  city             String
  state            String
  address          String
  price            Int
  unitCount        Int
  minInvestment    Int
  estimatedROI     Float
  estimatedMonths  String

  summary           String
  propertyFacts     Json
  investmentDetails Json
  images            String[]

  status               PropertyStatus @default(FUNDING)
  progressPercent      Int            @default(0)
  startDate            DateTime?
  targetCompletionDate DateTime?
  completedAt          DateTime?
  deletedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyType      PropertyType       @relation(fields: [typeId], references: [id])
  investments       Investment[]
  investmentIntents InvestmentIntent[]
  documents         PropertyDocument[]

  @@index([deletedAt])
  @@index([typeId])
}

enum PropertyStatus {
  FUNDING
  FUNDED
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum PropertyDocumentKind {
  CONSTRUCTION_PHOTOS
  CONTRACT
  FINANCIAL_REPORT
  PERMIT
  PROGRESS_UPDATE
  OTHER
}

model PropertyDocument {
  id           String               @id @default(cuid())
  propertyId   String
  kind         PropertyDocumentKind
  storageKey   String
  fileName     String
  mimeType     String
  uploadedAt   DateTime             @default(now())
  uploadedById Int?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, kind, uploadedAt])
}

model Investment {
  id         String   @id @default(cuid())
  userId     Int
  propertyId String
  amount     Float
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
}

model PageContent {
  id        String   @id @default(cuid())
  pageKey   PageKey
  locale    String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageKey, locale])
}

enum PageKey {
  HOME
  ABOUT
  FAQ
}
